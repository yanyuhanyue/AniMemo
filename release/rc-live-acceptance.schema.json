{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanyuhanyue/AniMemo/blob/main/release/rc-live-acceptance.schema.json",
  "title": "AniMemo RC Live Acceptance Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "rc_tag",
    "rc_commit",
    "release_manifest_identity",
    "deployment_contract_identity",
    "installer_materials_identity",
    "api_digest",
    "web_digest",
    "fresh_base_identity",
    "docker_base_identity",
    "runtime_base_identity",
    "install_path",
    "doctor_result",
    "upgrade_result",
    "accepted_at",
    "operator_identity",
    "tool_identity"
  ],
  "properties": {
    "schema": {"const": "animemo.rc-live-acceptance/v1"},
    "identity": {"$ref": "#/$defs/sha256"},
    "rc_tag": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-rc\\.[1-9][0-9]*$"
    },
    "rc_commit": {"$ref": "#/$defs/gitSha"},
    "release_manifest_identity": {"$ref": "#/$defs/sha256"},
    "deployment_contract_identity": {"$ref": "#/$defs/sha256"},
    "installer_materials_identity": {"$ref": "#/$defs/sha256"},
    "api_digest": {"$ref": "#/$defs/sha256"},
    "web_digest": {"$ref": "#/$defs/sha256"},
    "fresh_base_identity": {"$ref": "#/$defs/sha256"},
    "docker_base_identity": {"$ref": "#/$defs/sha256"},
    "runtime_base_identity": {"$ref": "#/$defs/sha256"},
    "install_path": {"enum": ["github", "official-mirror"]},
    "doctor_result": {"const": "PASS"},
    "upgrade_result": {"enum": ["PASS", "NOT_APPLICABLE"]},
    "accepted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "operator_identity": {"type": "string", "minLength": 1, "maxLength": 200},
    "tool_identity": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
