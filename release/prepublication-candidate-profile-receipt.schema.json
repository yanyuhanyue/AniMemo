{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animemo.cc/schemas/prepublication-candidate-profile-receipt-v1.json",
  "title": "AniMemo prepublication candidate profile receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "candidate_input_digest", "verified_candidate_digest",
    "qualification_run_id", "qualification_run_attempt", "source_sha", "source_tree",
    "candidate_version", "profile", "base_vm_identity", "snapshot_identity", "clone_identity",
    "initial_platform_state", "platform_bootstrap_plan_digest", "platform_bootstrap_receipt_digest",
    "strict_platform_qualification", "instance_mutation_before_platform_qualification",
    "installer_plan_digest", "installer_execution_result", "api_digest", "web_digest",
    "postgres_digest", "redis_digest", "doctor_result", "canonical_test_results",
    "network_request_count", "apt_command_count", "external_pull_count",
    "original_vm_pre_hashes", "original_vm_post_hashes", "release_authority_granted",
    "publish_authorized", "started_at", "completed_at", "result"
  ],
  "properties": {
    "schema": {"const": "animemo.prepublication-candidate-profile-receipt/v1"},
    "version": {"const": 1},
    "candidate_input_digest": {"$ref": "#/$defs/digest"},
    "verified_candidate_digest": {"$ref": "#/$defs/digest"},
    "qualification_run_id": {"type": "integer", "minimum": 1},
    "qualification_run_attempt": {"const": 1},
    "source_sha": {"$ref": "#/$defs/gitSha"},
    "source_tree": {"$ref": "#/$defs/gitSha"},
    "candidate_version": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-rc\\.[1-9][0-9]*$"},
    "profile": {"enum": ["FRESH_BASE", "DOCKER_BASE", "RUNTIME_BASE_OFFLINE"]},
    "base_vm_identity": {"$ref": "#/$defs/digest"},
    "snapshot_identity": {"$ref": "#/$defs/digest"},
    "clone_identity": {"$ref": "#/$defs/digest"},
    "initial_platform_state": {
      "type": "object", "additionalProperties": false,
      "required": ["docker_present", "runtime_dependencies_present", "network_allowed"],
      "properties": {
        "docker_present": {"type": "boolean"},
        "runtime_dependencies_present": {"type": "boolean"},
        "network_allowed": {"type": "boolean"}
      }
    },
    "platform_bootstrap_plan_digest": {"$ref": "#/$defs/digest"},
    "platform_bootstrap_receipt_digest": {"$ref": "#/$defs/digest"},
    "strict_platform_qualification": {"const": true},
    "instance_mutation_before_platform_qualification": {"const": 0},
    "installer_plan_digest": {"$ref": "#/$defs/digest"},
    "installer_execution_result": {"enum": ["PASS", "FAIL"]},
    "api_digest": {"$ref": "#/$defs/digest"},
    "web_digest": {"$ref": "#/$defs/digest"},
    "postgres_digest": {"$ref": "#/$defs/digest"},
    "redis_digest": {"$ref": "#/$defs/digest"},
    "doctor_result": {"enum": ["PASS", "FAIL"]},
    "canonical_test_results": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "result": {"enum": ["PASS", "FAIL"]}
        }
      }
    },
    "network_request_count": {"type": "integer", "minimum": 0},
    "apt_command_count": {"type": "integer", "minimum": 0},
    "external_pull_count": {"type": "integer", "minimum": 0},
    "original_vm_pre_hashes": {"$ref": "#/$defs/hashMap"},
    "original_vm_post_hashes": {"$ref": "#/$defs/hashMap"},
    "release_authority_granted": {"const": false},
    "publish_authorized": {"const": false},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["PASS", "FAIL"]}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hashMap": {
      "type": "object", "minProperties": 1, "maxProperties": 64,
      "propertyNames": {"type": "string", "pattern": "^[^/\\\\\\u0000-\\u001f]{1,256}$"},
      "additionalProperties": {"$ref": "#/$defs/digest"}
    }
  }
}
