# ---------- React / Cloudflare Pages ----------
# 本地留空时会自动跟随当前页面的 localhost 或 127.0.0.1，避免 Cookie/CSRF 主机名不一致。
# Cloudflare Pages 必须配置正式 API 地址，并重新构建。
VITE_API_BASE_URL=
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEJEYlI1RatjtDbd
# 可选：填公开手账 UUID 后，首页会每 60 秒从 Django 刷新真实公开记录与统计。
VITE_PUBLIC_SHOWCASE_SLUG=

# ---------- Django / Render ----------
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
CREDENTIAL_ENCRYPTION_KEY=
MEDIA_LOCAL_STORAGE_ROOT=
ANIME_JOURNAL_VERSION=0.0.0
# 可选：插件清单目录。默认使用项目根目录下的 plugins。
PLUGIN_ROOT=
PLUGIN_ASSET_SESSION_SECONDS=120
PLUGIN_PREVIEW_SESSION_SECONDS=600
PLUGIN_MAX_PACKAGE_BYTES=26214400
PLUGIN_MAX_UNCOMPRESSED_BYTES=104857600
PLUGIN_MAX_FILES=1000
PLUGIN_MAX_COMPRESSION_RATIO=100
PLUGIN_DRAFT_LIMIT=20
PLUGIN_UPLOADS_PER_HOUR=12
PLUGIN_PACKAGE_GC_GRACE_SECONDS=86400
# 生产环境只导入这里显式列出的第三方后端插件；内置可信插件另有核心白名单。
PLUGIN_LOAD_ALLOWLIST=watch-history-importer

# Provider-neutral Integration Protocol v1.
INTEGRATION_PAIRING_CODE_TTL_SECONDS=600
INTEGRATION_HMAC_TIMESTAMP_TOLERANCE_SECONDS=300
# Must cover the full +/- timestamp window.
INTEGRATION_HMAC_NONCE_TTL_SECONDS=660
INTEGRATION_ACTION_REQUEST_MAX_BYTES=262144
INTEGRATION_PAIRING_REQUEST_MAX_BYTES=8192
INTEGRATION_ACK_REQUEST_MAX_BYTES=16384
INTEGRATION_EVENT_PAYLOAD_MAX_BYTES=65536
INTEGRATION_EVENT_WAIT_DEFAULT_SECONDS=1
INTEGRATION_EVENT_WAIT_MAX_SECONDS=25
INTEGRATION_ACTION_RECEIPT_WAIT_SECONDS=5
INTEGRATION_ACKED_EVENT_RETENTION_SECONDS=86400
INTEGRATION_UNACKED_EVENT_RETENTION_SECONDS=604800
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
FRONTEND_URL=http://localhost:5173
BANGUMI_USER_AGENT="AniMemo/1.0 (+https://re-anime.cc)"
BANGUMI_IMAGE_PROXY_BASE_URL=https://bgm-img-proxy.xhcytus100.workers.dev/
BANGUMI_ACCOUNT_INTEGRATION_ENABLED=true
BANGUMI_OAUTH_CLIENT_ID=
BANGUMI_OAUTH_CLIENT_SECRET=
BANGUMI_OAUTH_REDIRECT_URI=http://localhost:8000/api/external-accounts/bangumi/callback/
BANGUMI_OAUTH_STATE_TTL_SECONDS=600
BANGUMI_IMPORT_MAX_ITEMS=1000
BANGUMI_IMPORT_PREVIEW_TTL_SECONDS=1200
BANGUMI_IMPORT_APPLY_MAX_ITEMS=100
TURNSTILE_ENABLED=true
TURNSTILE_SECRET=
REGISTRATION_TOKEN_TTL_SECONDS=3600
REGISTRATION_COMPLETION_TOKEN_TTL_SECONDS=900
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174
TRUSTED_PROXY_IPS=127.0.0.1/32,172.28.0.0/16

# 生产环境必须使用所有 Worker 共享的 Redis 缓存保存限流计数。
REDIS_URL=

# refresh token 仅写入 HttpOnly Cookie。跨站部署需改为 SameSite=None 且 Secure=true。
REFRESH_COOKIE_NAME=anime_journal_refresh
REFRESH_COOKIE_PATH=/api/
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
ALLOW_INSECURE_PRODUCTION_COOKIES=false

# 核心图片净化上限（头像/站点头像 2MB，海报/专栏封面 5MB）。
AVATAR_UPLOAD_MAX_BYTES=2097152
POSTER_UPLOAD_MAX_BYTES=5242880
COLUMN_COVER_UPLOAD_MAX_BYTES=5242880

# DRF 风险接口限流。
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=300/min
THROTTLE_LOGIN_RATE=5/min
THROTTLE_LOGIN_IP_RATE=10/min
THROTTLE_LOGIN_ACCOUNT_RATE=10/15min
THROTTLE_LOGIN_COMBINED_RATE=5/min
THROTTLE_PASSWORD_RESET_RATE=3/hour
THROTTLE_PASSWORD_RESET_IP_RATE=5/hour
THROTTLE_PASSWORD_RESET_ACCOUNT_RATE=3/hour
THROTTLE_PASSWORD_RESET_COMBINED_RATE=3/hour
THROTTLE_REGISTER_RATE=3/hour
THROTTLE_REGISTER_IP_RATE=10/hour
THROTTLE_REGISTER_EMAIL_RATE=3/hour
THROTTLE_REGISTER_COMBINED_RATE=3/hour
THROTTLE_TWO_FACTOR_RATE=2/min
THROTTLE_TWO_FACTOR_IP_RATE=10/10min
THROTTLE_TWO_FACTOR_ACCOUNT_RATE=5/10min
THROTTLE_TWO_FACTOR_COMBINED_RATE=3/5min
THROTTLE_EXTERNAL_SEARCH_RATE=30/min
THROTTLE_IMPORT_RATE=5/hour
ADMIN_2FA_SESSION_MAX_AGE=28800

# 普通手账 JSON/CSV 导入安全限制。
IMPORT_FILE_MAX_BYTES=2097152
IMPORT_MAX_RECORDS=500
IMPORT_FIELD_MAX_LENGTH=10000
IMPORT_MAX_COLUMNS=32
IMPORT_MAX_LINE_LENGTH=200000
IMPORT_MAX_NESTING_DEPTH=3

# Neon：复制 Pooled connection string。生产环境建议追加 sslmode=require。
DATABASE_URL=

# R2 与正式 Local Media Storage 均由 Superuser 在媒体存储后台配置。

# Resend：From 地址必须属于已验证域名。
RESEND_API_KEY=
RESEND_FROM_EMAIL=Anime Journal <hello@example.com>
