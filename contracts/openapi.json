{
  "openapi": "3.1.0",
  "info": {
    "title": "AniMemo API",
    "version": "0.1.0",
    "description": "Private journal API. Every unsafe request must supply Origin equal to PUBLIC_ORIGIN. JSON bodies reject unknown fields. Authentication uses an HttpOnly same-site session cookie. All entries and viewing records are owner-scoped. A viewing record advances progress to the furthest recorded episode; rewatches do not decrease it. total_episodes=0 means unknown. Marking an entry completed with a known total also sets its progress to that total."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Process health",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Database readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Create account and session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Sign in and rotate session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoke the browser session",
        "security": [],
        "responses": {
          "204": {
            "description": "No content"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Current account",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/entries": {
      "get": {
        "summary": "List your journal",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "planned",
                "watching",
                "completed",
                "on_hold",
                "dropped"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "updated",
                "title",
                "score"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryPage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "summary": "Create a journal entry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEntry"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/entries/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read your entry",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "patch": {
        "summary": "Update against the version displayed to the user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchEntry"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "summary": "Delete the entry and its viewing records",
        "parameters": [
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No content"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/entries/{id}/history": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Latest 100 viewing records for this entry",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "summary": "Record viewing and atomically advance progress",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/history": {
      "get": {
        "summary": "Latest 100 viewing records across your journal",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/stats": {
      "get": {
        "summary": "Your journal totals",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/export": {
      "get": {
        "summary": "Consistent personal export, up to 5000 entries and 20000 records",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Export"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "animemo_session"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "display_name": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1
          }
        }
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password",
          "display_name"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 12,
            "description": "At least 12 characters and at most 72 UTF-8 bytes."
          },
          "display_name": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1
          }
        }
      },
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 72
          }
        }
      },
      "Entry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "original_title",
          "format",
          "status",
          "total_episodes",
          "score",
          "notes",
          "tags",
          "accent",
          "watched_episodes",
          "version",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "original_title": {
            "type": "string",
            "maxLength": 160
          },
          "format": {
            "type": "string",
            "enum": [
              "tv",
              "movie",
              "ova",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "watching",
              "completed",
              "on_hold",
              "dropped"
            ]
          },
          "total_episodes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "notes": {
            "type": "string",
            "maxLength": 4000
          },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 24,
              "minLength": 1
            }
          },
          "accent": {
            "type": "string",
            "enum": [
              "violet",
              "coral",
              "blue",
              "green",
              "amber"
            ]
          },
          "watched_episodes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "original_title": {
            "type": "string",
            "maxLength": 160
          },
          "format": {
            "type": "string",
            "enum": [
              "tv",
              "movie",
              "ova",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "watching",
              "completed",
              "on_hold",
              "dropped"
            ]
          },
          "total_episodes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "notes": {
            "type": "string",
            "maxLength": 4000
          },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 24,
              "minLength": 1
            }
          },
          "accent": {
            "type": "string",
            "enum": [
              "violet",
              "coral",
              "blue",
              "green",
              "amber"
            ]
          }
        }
      },
      "PatchEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "original_title": {
            "type": "string",
            "maxLength": 160
          },
          "format": {
            "type": "string",
            "enum": [
              "tv",
              "movie",
              "ova",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "watching",
              "completed",
              "on_hold",
              "dropped"
            ]
          },
          "total_episodes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "0 clears the score; omitted fields remain unchanged."
          },
          "notes": {
            "type": "string",
            "maxLength": 4000
          },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 24,
              "minLength": 1
            }
          },
          "accent": {
            "type": "string",
            "enum": [
              "violet",
              "coral",
              "blue",
              "green",
              "amber"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "RecordInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "watched_on",
          "episode_from",
          "episode_to",
          "request_id"
        ],
        "properties": {
          "watched_on": {
            "type": "string",
            "format": "date"
          },
          "episode_from": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "episode_to": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable for retries of this exact write. Reusing it with different content returns 409."
          }
        }
      },
      "WatchRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entry_id",
          "entry_title",
          "accent",
          "watched_on",
          "episode_from",
          "episode_to",
          "note",
          "request_id",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "entry_id": {
            "type": "string",
            "format": "uuid"
          },
          "entry_title": {
            "type": "string"
          },
          "accent": {
            "type": "string",
            "enum": [
              "violet",
              "coral",
              "blue",
              "green",
              "amber"
            ]
          },
          "watched_on": {
            "type": "string",
            "format": "date"
          },
          "episode_from": {
            "type": "integer",
            "minimum": 1
          },
          "episode_to": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RecordResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "record"
        ],
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/Entry"
          },
          "record": {
            "$ref": "#/components/schemas/WatchRecord"
          }
        }
      },
      "EntryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "History": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/WatchRecord"
            }
          }
        }
      },
      "Stats": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "watching",
          "completed",
          "planned",
          "on_hold",
          "dropped",
          "watched_episodes",
          "watch_records"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "watching": {
            "type": "integer",
            "minimum": 0
          },
          "completed": {
            "type": "integer",
            "minimum": 0
          },
          "planned": {
            "type": "integer",
            "minimum": 0
          },
          "on_hold": {
            "type": "integer",
            "minimum": 0
          },
          "dropped": {
            "type": "integer",
            "minimum": 0
          },
          "watched_episodes": {
            "type": "integer",
            "minimum": 0
          },
          "watch_records": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Export": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "exported_at",
          "entries",
          "history"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "animemo.journal/v1"
          },
          "exported_at": {
            "type": "string",
            "format": "date-time"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WatchRecord"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Success",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
