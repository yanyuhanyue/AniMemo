DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
MEDIA_LOCAL_STORAGE_ROOT=/data/animemo/media
ANIMEMO_DATA_ROOT=/data/animemo
FIRST_RUN_SETUP_CODE_PATH=/app/runtime/private/setup-code
FIRST_RUN_SETUP_CODE_TTL_SECONDS=3600
FIRST_RUN_SETUP_MAX_ATTEMPTS=8
# Normal production updates pin both values to release-manifest digests.
ANIMEMO_API_IMAGE=ghcr.io/yanyuhanyue/animemo-api@sha256:REPLACE_WITH_RELEASE_DIGEST
ANIMEMO_WEB_IMAGE=ghcr.io/yanyuhanyue/animemo-web@sha256:REPLACE_WITH_RELEASE_DIGEST
ALLOWED_HOSTS=animemo.cc
ANIMEMO_PUBLIC_ORIGIN=https://animemo.cc
ANIMEMO_MEDIA_PUBLIC_ORIGIN=https://media.animemo.cc
BANGUMI_IMAGE_PROXY_BASE_URL=https://bgm-img-proxy.xhcytus100.workers.dev/
BANGUMI_ACCOUNT_INTEGRATION_ENABLED=true
BANGUMI_OAUTH_CLIENT_ID=
BANGUMI_OAUTH_CLIENT_SECRET=
# OAuth callback: https://animemo.cc/api/v1/external-accounts/bangumi/callback/
# It is derived from ANIMEMO_PUBLIC_ORIGIN and is not separately configurable.
EXTERNAL_ACCOUNT_OAUTH_STATE_TTL_SECONDS=600
BANGUMI_IMPORT_MAX_ITEMS=1000
EXTERNAL_IMPORT_PREVIEW_TTL_SECONDS=1200
EXTERNAL_IMPORT_APPLY_MAX_ITEMS=100
EXTERNAL_SYNC_CONFIRMATION_MAX_AGE_SECONDS=300
CORS_ALLOWED_ORIGINS=https://animemo.cc
CSRF_TRUSTED_ORIGINS=https://animemo.cc
TRUSTED_PROXY_IPS=127.0.0.1/32,172.28.0.0/16
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=animemo
POSTGRES_USER=animemo
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://animemo:REPLACE_WITH_STRONG_RANDOM_PASSWORD@postgres:5432/animemo
# The private Compose network does not terminate PostgreSQL TLS. Set true for
# an external PostgreSQL service that requires encrypted client connections.
DATABASE_SSL_REQUIRE=false
PLUGIN_PACKAGE_ROOT=/app/runtime/plugins
PLUGIN_ASSET_SESSION_SECONDS=120
PLUGIN_PREVIEW_SESSION_SECONDS=600
PLUGIN_MAX_PACKAGE_BYTES=26214400
PLUGIN_MAX_UNCOMPRESSED_BYTES=104857600
PLUGIN_MAX_FILES=1000
PLUGIN_MAX_COMPRESSION_RATIO=100
PLUGIN_DRAFT_LIMIT=20
PLUGIN_UPLOADS_PER_HOUR=12
PLUGIN_PACKAGE_GC_GRACE_SECONDS=86400
PLUGIN_MIN_FREE_DISK_MB=2048
PLUGIN_KEEP_VERSIONS=2
SECURE_HSTS_PRELOAD=false
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=true
ADMIN_2FA_SESSION_MAX_AGE=28800
ALLOW_INSECURE_PRODUCTION_COOKIES=false
AVATAR_UPLOAD_MAX_BYTES=2097152
POSTER_UPLOAD_MAX_BYTES=5242880
COLUMN_COVER_UPLOAD_MAX_BYTES=5242880
CSRF_COOKIE_SAMESITE=Lax
IMPORT_FILE_MAX_BYTES=2097152
IMPORT_MAX_RECORDS=500
IMPORT_FIELD_MAX_LENGTH=10000
IMPORT_MAX_COLUMNS=32
IMPORT_MAX_LINE_LENGTH=200000
IMPORT_MAX_NESTING_DEPTH=3
THROTTLE_REGISTER_RATE=3/hour
THROTTLE_REGISTER_IP_RATE=10/hour
THROTTLE_REGISTER_EMAIL_RATE=3/hour
THROTTLE_REGISTER_COMBINED_RATE=3/hour
THROTTLE_FIRST_RUN_SETUP_RATE=10/hour
THROTTLE_FIRST_RUN_SETUP_IP_RATE=10/hour
THROTTLE_FIRST_RUN_SETUP_ACCOUNT_RATE=8/hour
THROTTLE_FIRST_RUN_SETUP_COMBINED_RATE=8/hour
THROTTLE_EXTERNAL_SYNC_PREVIEW_RATE=10/min
THROTTLE_EXTERNAL_SYNC_APPLY_RATE=6/min
