# AniMemo local development defaults. Turnstile is disabled in the database by
# default and can be configured later from Staff Site Settings.
DEBUG=true
DJANGO_SECRET_KEY=animemo-local-development-only-secret-key
CREDENTIAL_ENCRYPTION_KEY=
DATABASE_URL=
REDIS_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
ANIMEMO_PUBLIC_ORIGIN=http://localhost:5173
ANIMEMO_MEDIA_PUBLIC_ORIGIN=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173
REFRESH_COOKIE_NAME=animemo_refresh
REFRESH_COOKIE_PATH=/api/
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false
ALLOW_INSECURE_PRODUCTION_COOKIES=false
