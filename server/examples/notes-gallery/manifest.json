    "border": "#c8d4e2",
    "rule": "#bdcbdc",
    "heading_font": "sans",
    "reading_size": "standard",
    "spacing": "relaxed",
    "presentation": {
      "schema": 1,
      "scope": "private.notes",
      "list": "",
      "card": "",
      "reader": "",
      "css": "",
      "assets": [
