# Copy to .local/integrations.env for npm run dev. Keep credentials out of Git.
# Managed instances: npm run instance -- configure-external --name NAME --integrations-file .local/integrations.env
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BANGUMI_OAUTH_CLIENT_ID=
BANGUMI_OAUTH_CLIENT_SECRET=
# Must exactly equal PUBLIC_ORIGIN + /api/v1/connections/bangumi/callback
BANGUMI_OAUTH_REDIRECT_URI=
# Private, dedicated bucket. Account endpoint: https://<32-hex-account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
