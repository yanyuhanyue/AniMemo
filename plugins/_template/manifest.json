{
  "$schema": "../plugin.schema.json",
  "schemaVersion": 2,
  "sdkApi": 2,
  "id": "com.example.anime-journal.blank",
  "slug": "blank-plugin",
  "name": "空白插件",
  "version": "0.2.0",
  "description": "AniMemo Plugin SDK v2 的全栈插件模板。",
  "author": { "name": "Plugin Author" },
  "license": "MIT",
  "installationMode": "user",
  "runtimes": ["frontend", "backend"],
  "coreCapabilities": [],
  "frontend": { "exposure": "authenticated" },
  "extensions": ["frontend.page", "frontend.navigation", "backend.api", "settings", "storage", "integration.actions", "integration.events"],
  "backend": { "entry": "backend/plugin.py" },
  "integrations": {
    "actions": [{ "name": "echo", "description": "返回当前绑定用户与调用 payload。" }],
    "events": [{ "name": "notice", "description": "向当前用户的已启用外部绑定发送私聊事件。" }]
  },
  "permissions": [],
  "hooks": [],
  "settings": [{ "key": "panel_message", "scope": "user", "label": "面板提示文字", "description": "显示在空白插件示例面板中的状态说明。", "type": "text", "required": true, "default": "插件已连接" }],
  "dataPolicy": { "storesPersonalData": false, "usesExternalNetwork": false, "acceptsFileUploads": false, "retainsDataOnDisable": true }
}
